        <!-- War Booking Detail -->
        <mxCell id="war-title" value="War Booking Stress Test (war-booking.js)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="war-detail" value="Executor: ramping-vus&#xa;Stages: 20s ramp to 50 → 1m sustain at 100 → 20s ramp down&#xa;Contested Spots: 5-CAR-01, 5-CAR-02, 5-CAR-03&#xa;&#xa;Metrics:&#xa;• booking_won (Counter): VUs that successfully reserved&#xa;• booking_lost (Counter): VUs that got 409 (correct rejection)&#xa;• lock_correctness (Rate): &gt;90% of 409s are valid SPOT_TAKEN/SPOT_HELD&#xa;&#xa;Flow per VU:&#xa;1. holdSpot(contested_spot) → may get 409&#xa;2. pollReservation(USER_SELECTED, contested_spot) → 200 or 409&#xa;3. If won → cancelReservation (release for next iteration)&#xa;4. If lost → verify 409 is valid rejection code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="500" height="220" as="geometry" />
        </mxCell>
        <!-- Smoke Test -->
        <mxCell id="smoke-title" value="Smoke Test (smoke-test.js)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="650" y="560" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="smoke-detail" value="1 VU | 1 iteration — Sanity check&#xa;&#xa;Covers:&#xa;• S1: System-assigned full flow + idempotency&#xa;• S2: User-selected full flow&#xa;• S6: Wrong spot blocking&#xa;• S7: Cancel free (≤ 2 min)&#xa;• S12: Payment failure + retry&#xa;&#xa;Thresholds:&#xa;• http_req_failed &lt; 1%&#xa;• http_req_duration p99 &lt; 5000ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
