        <!-- Test Environment Note -->
        <mxCell id="env-note" value="Test Environment Notes:&#xa;• S5 (expiry) &amp; S8 (cancel &gt; 2 min): requires RESERVATION_TTL=30s, CANCEL_GRACE_PERIOD=10s&#xa;• S10 (overnight): requires clock manipulation or mock billing&#xa;• BASE_URL default: http://localhost:8000 (Kong Gateway local)&#xa;• Production target: https://parkir-pintar.pondongopi.biz.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
