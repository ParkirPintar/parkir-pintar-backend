<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-05-26T00:00:00.000Z" agent="draw.io" version="24.0.0" type="device">
  <diagram id="pricing-jdm" name="Pricing Rules — gorules JDM Decision Graph">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="ParkirPintar Pricing Engine — gorules/zen-go JDM Decision Graph" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="File: services/billing/rules/pricing.json | Engine: github.com/gorules/zen-go | Hot-reload: poll DB every 30s" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;strokeColor=none;fillColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="45" width="700" height="20" as="geometry" />
        </mxCell>

        <!-- ==================== INPUT NODE ==================== -->
        <mxCell id="input" value="INPUT NODE&#xa;(Pricing Input)&#xa;&#xa;durationHours: float64&#xa;midnightCrossings: int&#xa;cancelElapsedMinutes: float64&#xa;bookingFee: int64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- ==================== BOOKING FEE TABLE ==================== -->
        <mxCell id="bf-node" value="DECISION TABLE&#xa;Booking Fee&#xa;(hitPolicy: first)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bf-table" value="Input: bookingFee | Output: bookingFeeResult&#xa;&#xa;Rule 1: bookingFee &gt; 0 → bookingFeeResult = bookingFee&#xa;Rule 2: (default)      → bookingFeeResult = 5000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- ==================== HOURLY FEE EXPRESSION ==================== -->
        <mxCell id="hf-node" value="EXPRESSION NODE&#xa;Hourly Fee Calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hf-expr" value="Expression:&#xa;&#xa;hourlyFee =&#xa;  durationHours &gt; 0&#xa;    ? ceil(durationHours) * 5000&#xa;    : 0&#xa;&#xa;Example: 2.5h → ceil(2.5) = 3 → 15,000 IDR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="580" y="140" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== OVERNIGHT FEE EXPRESSION ==================== -->
        <mxCell id="on-node" value="EXPRESSION NODE&#xa;Overnight Fee Calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="830" y="100" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="on-expr" value="Expression:&#xa;&#xa;overnightFee =&#xa;  midnightCrossings &gt; 0&#xa;    ? midnightCrossings * 20000&#xa;    : 0&#xa;&#xa;Example: 2 nights → 2 × 20,000 = 40,000 IDR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== CANCELLATION FEE TABLE ==================== -->
        <mxCell id="cf-node" value="DECISION TABLE&#xa;Cancellation Fee&#xa;(hitPolicy: first)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="100" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cf-table" value="Input: cancelElapsedMinutes | Output: cancellationFee&#xa;&#xa;Rule 1: cancelElapsedMinutes &gt; 2 → cancellationFee = 5000&#xa;Rule 2: (default)              → cancellationFee = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="140" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- ==================== TOTAL EXPRESSION ==================== -->
        <mxCell id="total-node" value="EXPRESSION NODE&#xa;Total Calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="310" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="total-expr" value="Expression:&#xa;&#xa;total = bookingFeeResult&#xa;      + hourlyFee&#xa;      + overnightFee&#xa;      + cancellationFee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1080" y="350" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- ==================== OUTPUT NODE ==================== -->
        <mxCell id="output" value="OUTPUT NODE&#xa;(Pricing Output)&#xa;&#xa;bookingFeeResult: int64&#xa;hourlyFee: int64&#xa;overnightFee: int64&#xa;cancellationFee: int64&#xa;total: int64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;fontStyle=1;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1350" y="290" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- ==================== EDGES (Decision Graph Flow) ==================== -->
        <!-- Input → Booking Fee -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="input" target="bf-node" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Booking Fee → Hourly Fee -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="bf-node" target="hf-node" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Hourly Fee → Overnight Fee -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="hf-node" target="on-node" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Overnight Fee → Cancellation Fee -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="on-node" target="cf-node" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Cancellation Fee → Total -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" source="cf-table" target="total-node" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Total → Output -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;entryX=0;entryY=0.3;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="total-node" target="output" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== passThrough annotation ==================== -->
        <mxCell id="pt-note" value="All nodes use passThrough=true&#xa;(accumulated context flows through entire graph)" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;strokeColor=none;fillColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="260" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== EXAMPLES SECTION ==================== -->
        <mxCell id="examples-title" value="Evaluation Examples" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="200" height="25" as="geometry" />
        </mxCell>

        <!-- Example 1: Normal checkout -->
        <mxCell id="ex1" value="Example 1: Normal Checkout (3 hours, no overnight)&#xa;&#xa;Input:  { durationHours: 3, midnightCrossings: 0, cancelElapsedMinutes: 0, bookingFee: 5000 }&#xa;&#xa;→ bookingFeeResult = 5000 (bookingFee &gt; 0, use passed value)&#xa;→ hourlyFee = ceil(3) × 5000 = 15,000&#xa;→ overnightFee = 0 (no crossings)&#xa;→ cancellationFee = 0 (not a cancel)&#xa;→ total = 5000 + 15000 + 0 + 0 = 20,000 IDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="500" height="140" as="geometry" />
        </mxCell>

        <!-- Example 2: Overnight -->
        <mxCell id="ex2" value="Example 2: Overnight Parking (8 hours, 1 midnight crossing)&#xa;&#xa;Input:  { durationHours: 8, midnightCrossings: 1, cancelElapsedMinutes: 0, bookingFee: 5000 }&#xa;&#xa;→ bookingFeeResult = 5000&#xa;→ hourlyFee = ceil(8) × 5000 = 40,000&#xa;→ overnightFee = 1 × 20,000 = 20,000&#xa;→ cancellationFee = 0&#xa;→ total = 5000 + 40000 + 20000 + 0 = 65,000 IDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="500" height="140" as="geometry" />
        </mxCell>

        <!-- Example 3: Cancellation -->
        <mxCell id="ex3" value="Example 3: Cancellation after 5 minutes&#xa;&#xa;Input:  { durationHours: 0, midnightCrossings: 0, cancelElapsedMinutes: 5, bookingFee: 5000 }&#xa;&#xa;→ bookingFeeResult = 5000&#xa;→ hourlyFee = 0 (duration = 0)&#xa;→ overnightFee = 0&#xa;→ cancellationFee = 5000 (elapsed &gt; 2 min)&#xa;→ total = 5000 + 0 + 0 + 5000 = 10,000 IDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="600" y="450" width="500" height="140" as="geometry" />
        </mxCell>

        <!-- Example 4: Free cancellation -->
        <mxCell id="ex4" value="Example 4: Free Cancellation (within 2 minutes)&#xa;&#xa;Input:  { durationHours: 0, midnightCrossings: 0, cancelElapsedMinutes: 1, bookingFee: 5000 }&#xa;&#xa;→ bookingFeeResult = 5000&#xa;→ hourlyFee = 0&#xa;→ overnightFee = 0&#xa;→ cancellationFee = 0 (elapsed ≤ 2 min → free)&#xa;→ total = 5000 + 0 + 0 + 0 = 5,000 IDR (booking fee only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="500" height="140" as="geometry" />
        </mxCell>

        <!-- ==================== HOT-RELOAD FLOW ==================== -->
        <mxCell id="reload-title" value="Hot-Reload Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="780" width="200" height="25" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="Billing Service&#xa;starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="50" y="815" width="100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Load rules from file&#xa;rules/pricing.json&#xa;(or DB fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="190" y="815" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Initialize&#xa;zen.Engine +&#xa;zen.Decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="360" y="815" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Poll DB&#xa;every 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="510" y="815" width="90" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="Version&#xa;changed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="640" y="810" width="90" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="Reload rules&#xa;into engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="780" y="815" width="100" height="45" as="geometry" />
        </mxCell>

        <!-- Hot-reload arrows -->
        <mxCell id="ra1" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="r1" target="r2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ra2" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="r2" target="r3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ra3" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="r3" target="r4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ra4" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="r4" target="r5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ra5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="r5" target="r6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ra6" value="No" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;curved=1;" edge="1" source="r5" target="r4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="685" y="890" />
              <mxPoint x="555" y="890" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== DB SCHEMA ==================== -->
        <mxCell id="db-title" value="DB Schema: pricing_rules table" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="920" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="db-schema" value="CREATE TABLE pricing_rules (&#xa;    id          UUID PRIMARY KEY DEFAULT gen_random_uuid(),&#xa;    version     INT NOT NULL,&#xa;    name        VARCHAR(100) NOT NULL,&#xa;    content     JSONB NOT NULL,   -- JDM rule graph (this file)&#xa;    is_active   BOOLEAN DEFAULT true,&#xa;    created_at  TIMESTAMP DEFAULT now()&#xa;);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="50" y="950" width="420" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== PRICING SUMMARY TABLE ==================== -->
        <mxCell id="summary-title" value="Pricing Rules Summary" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="920" width="200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="summary-table" value="| Condition                    | Fee                              |&#xa;|------------------------------|----------------------------------|&#xa;| Booking fee (on confirm)     | 5,000 IDR (passed in input)      |&#xa;| First hour                   | 5,000 IDR                        |&#xa;| Each subsequent started hour | 5,000 IDR (ceil rounding)        |&#xa;| Overnight (midnight cross)   | 20,000 IDR flat per crossing     |&#xa;| Cancel ≤ 2 min               | 0 IDR (free)                     |&#xa;| Cancel &gt; 2 min               | 5,000 IDR                        |&#xa;| No-show                      | Forfeits booking fee only        |&#xa;| Overstay                     | Standard hourly rate continues   |&#xa;| Wrong spot                   | BLOCKED (not a fee — access denied)|" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="530" y="950" width="420" height="160" as="geometry" />
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend-title" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1200" y="450" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1200" y="475" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg1t" value="Input / Output nodes" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1225" y="472" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1200" y="495" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg2t" value="Decision Table nodes (hitPolicy: first)" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1225" y="492" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1200" y="515" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg3t" value="Expression nodes (calculations)" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1225" y="512" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1200" y="535" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg4t" value="Output node (final result)" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1225" y="532" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Key design note -->
        <mxCell id="design-note" value="Key Design Decisions:&#xa;• No fallback — JDM engine MUST be initialized with valid rules&#xa;• passThrough=true on all nodes — accumulated context flows through&#xa;• hitPolicy=first on decision tables — first matching rule wins&#xa;• Rules stored in PostgreSQL (JSONB) for hot-reload without redeploy&#xa;• File-based loading as primary, DB as fallback source&#xa;• No no-show fee in JDM — driver simply forfeits booking fee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="580" width="320" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
