<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-05-26T00:00:00.000Z" agent="draw.io" version="24.0.0" type="device">
  <diagram id="e2e-postman" name="E2E Test Flow (Postman/Newman)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="ParkirPintar E2E Test Flow (Postman/Newman Collection)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== USER_SELECTED HAPPY PATH (Left Column) ==================== -->
        <mxCell id="lane1-title" value="USER_SELECTED Happy Path (Steps 1–10)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="55" width="380" height="25" as="geometry" />
        </mxCell>

        <!-- Step 1: Search -->
        <mxCell id="s1" value="1. Search Availability&#xa;&#xa;1a. GET /v1/availability?floor=3&amp;vehicle_type=CAR&#xa;1b. GET /v1/availability/first?vehicle_type=MOTORCYCLE&#xa;&#xa;Assert: 200, spots array, total_available &gt; 0&#xa;Saves: hold_spot_id (random available spot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="85" width="380" height="100" as="geometry" />
        </mxCell>

        <!-- Step 2: Hold Spot -->
        <mxCell id="s2" value="2. Hold Spot&#xa;&#xa;2a. POST /v1/spots/{hold_spot_id}/hold&#xa;     Assert: 200, has spot_id, has held_until (60s TTL)&#xa;2b. POST /v1/spots/{hold_spot_id}/hold (different driver)&#xa;     Assert: 409 — spot already held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="205" width="380" height="95" as="geometry" />
        </mxCell>

        <!-- Step 3: Reservation -->
        <mxCell id="s3" value="3. Reservation (USER_SELECTED)&#xa;&#xa;3a. POST /v1/reservations (Idempotency-Key header)&#xa;     Assert: 200/201, status=RESERVED, booking_fee=5000&#xa;     Assert: spot_id matches held spot&#xa;3b. Same request, same Idempotency-Key → same result&#xa;3c. Poll for reservation_id (up to 10 attempts)&#xa;     Saves: reservation_id, booking_payment_id, qr_code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="320" width="380" height="120" as="geometry" />
        </mxCell>

        <!-- Step 4: Booking Fee Payment -->
        <mxCell id="s4" value="4. Booking Fee Payment&#xa;&#xa;4a. GET /v1/payments/{booking_payment_id}&#xa;     Assert: 200, status ∈ {PENDING, PAID, FAILED}&#xa;     Assert: amount = 5000 (booking fee)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="460" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- Step 5: Check-in -->
        <mxCell id="s5" value="5. Check-in (Correct Spot)&#xa;&#xa;5a. POST /v1/checkin {reservation_id, spot_id}&#xa;     Assert: 200, status=ACTIVE, wrong_spot=false&#xa;     Triggers: Billing.StartBillingSession" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- Step 6: Location Update -->
        <mxCell id="s6" value="6. Location Update&#xa;&#xa;6a. POST /v1/presence/location {reservation_id, lat, lng}&#xa;     Assert: 200, has event field&#xa;     Simulates: driver app sending location every ≤30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="660" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- Step 7: Checkout -->
        <mxCell id="s7" value="7. Checkout (Generate Invoice + QRIS)&#xa;&#xa;7a. POST /v1/checkout {reservation_id} (Idempotency-Key)&#xa;     Assert: 200, has invoice_id, has payment_id&#xa;     Assert: total ≥ 0 (booking fee deducted as deposit)&#xa;     Assert: status=PENDING&#xa;     Formula: total = hourly_fee + overnight_fee - booking_fee&#xa;     Saves: payment_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="760" width="380" height="120" as="geometry" />
        </mxCell>

        <!-- Step 8: Checkout Payment -->
        <mxCell id="s8" value="8. Checkout Payment (Poll until PAID)&#xa;&#xa;8a. GET /v1/payments/{payment_id}&#xa;     Assert: status ∈ {PENDING, PAID} (driver hasn't scanned QR)&#xa;8b. GET /v1/payments/{payment_id} (after 3s delay)&#xa;     Assert: status = PAID (driver scanned QR and paid)&#xa;     Gate can now open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="900" width="380" height="100" as="geometry" />
        </mxCell>

        <!-- Step 10: Exit Gate -->
        <mxCell id="s10" value="10. Exit Gate&#xa;&#xa;10a. POST /v1/checkout/gate {reservation_id}&#xa;      Assert: 200, status=CHECKOUT_INITIATED&#xa;      Driver exits parking area" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="1020" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- Flow arrows: USER_SELECTED happy path -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s1" target="s2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s2" target="s3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s3" target="s4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s4" target="s5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s5" target="s6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s6" target="s7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s7" target="s8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" value="Payment PAID → Gate opens" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;fontStyle=2;" edge="1" source="s8" target="s10" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ==================== CANCEL FLOW (Right Column, Top) ==================== -->
        <mxCell id="lane2-title" value="Cancel Flow (Step 9 — Separate Reservation)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="580" y="55" width="380" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s9a" value="9a. Hold spot for cancel test&#xa;&#xa;POST /v1/spots/{cancel_spot_id}/hold&#xa;(Floor 2, MOTORCYCLE, new driver)&#xa;Assert: 200, has spot_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="85" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s9b" value="9b. Create reservation to cancel&#xa;&#xa;POST /v1/reservations (new Idempotency-Key)&#xa;Assert: 200/201&#xa;Saves: cancel_reservation_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="185" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s9c" value="9c. Poll cancel reservation_id&#xa;&#xa;POST /v1/reservations (same Idempotency-Key)&#xa;Poll up to 10 attempts until reservation_id resolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="285" width="380" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s9d" value="9d. Cancel Reservation&#xa;&#xa;DELETE /v1/reservations/{cancel_reservation_id}&#xa;Assert: 200, status=CANCELLED&#xa;Assert: has cancellation_fee (0 if ≤2min, 5000 if &gt;2min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="375" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- Cancel flow arrows -->
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s9a" target="s9b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s9b" target="s9c" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s9c" target="s9d" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ==================== SYSTEM_ASSIGNED FULL FLOW (Right Column, Bottom) ==================== -->
        <mxCell id="lane3-title" value="SYSTEM_ASSIGNED Full Flow (Step 11)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="580" y="500" width="380" height="25" as="geometry" />
        </mxCell>

        <mxCell id="s11a" value="11a. Reserve (SYSTEM_ASSIGNED)&#xa;&#xa;POST /v1/reservations {mode=SYSTEM_ASSIGNED, vehicle_type=CAR}&#xa;Assert: 200/201, has spot_id, status=RESERVED, booking_fee=5000&#xa;No hold step needed — system picks first available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="530" width="380" height="85" as="geometry" />
        </mxCell>

        <mxCell id="s11b" value="11b. Poll SA reservation_id&#xa;&#xa;POST /v1/reservations (same Idempotency-Key)&#xa;Poll up to 10 attempts&#xa;Saves: sa_reservation_id, sa_spot_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="635" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s11c" value="11c. Check-in (SA correct spot)&#xa;&#xa;POST /v1/checkin {sa_reservation_id, sa_spot_id}&#xa;Assert: 200, status=ACTIVE, wrong_spot=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="735" width="380" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s11d" value="11d. Checkout (SA)&#xa;&#xa;POST /v1/checkout {sa_reservation_id} (Idempotency-Key)&#xa;Assert: 200, has invoice_id, has payment_id&#xa;Assert: total ≥ 0, status=PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="825" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s11e" value="11e. Payment Status (SA)&#xa;&#xa;GET /v1/payments/{sa_payment_id}&#xa;Assert: 200, status ∈ {PENDING, PAID, FAILED}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="925" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- System-assigned flow arrows -->
        <mxCell id="sa1" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s11a" target="s11b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sa2" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s11b" target="s11c" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sa3" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s11c" target="s11d" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sa4" style="edgeStyle=orthogonalEdgeStyle;fontSize=8;" edge="1" source="s11d" target="s11e" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ==================== ARCHITECTURE NOTE ==================== -->
        <mxCell id="arch-note" value="Test Architecture: Newman/Postman → Cloudflare (HTTPS) → Kong Gateway (rate limit) → Gateway Service (REST→gRPC translation) → Backend gRPC Services (Search, Reservation, Billing, Payment, Presence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="1130" width="860" height="35" as="geometry" />
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend-title" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="1175" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="1200" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg1t" value="Core actions (search, check-in, exit)" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="125" y="1197" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="1220" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg2t" value="Hold / System-assigned flow" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="125" y="1217" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="1240" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg3t" value="Reservation / Checkout (billing)" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="125" y="1237" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="1260" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg4t" value="Payment (QRIS polling)" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="125" y="1257" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg5" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="100" y="1280" width="20" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg5t" value="Cancel flow (separate reservation)" style="text;html=1;align=left;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="125" y="1277" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- ==================== NOT COVERED NOTE ==================== -->
        <mxCell id="not-covered" value="Scenarios NOT covered by E2E (require real time passage):&#xa;• Overnight fee calculation (real midnight crossing)&#xa;• No-show expiry (1 hour timeout)&#xa;• Wrong-spot blocking (needs second spot assignment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="1020" width="380" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
