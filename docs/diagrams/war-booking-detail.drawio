        </mxCell>
        <mxCell id="seg0" parent="1" style="text;html=1;fontSize=7;fontStyle=1;align=center;verticalAlign=middle;fillColor=#3B82F6;fontColor=#FFFFFF;rounded=1;strokeColor=none;" value="queue.0&#xa;points 0-9" vertex="1">
          <mxGeometry height="25" width="70" x="1205" y="650" as="geometry" />
        </mxCell>
        <mxCell id="seg1" parent="1" style="text;html=1;fontSize=7;fontStyle=1;align=center;verticalAlign=middle;fillColor=#8B5CF6;fontColor=#FFFFFF;rounded=1;strokeColor=none;" value="queue.1&#xa;points 10-19" vertex="1">
          <mxGeometry height="25" width="70" x="1320" y="740" as="geometry" />
        </mxCell>
        <mxCell id="seg2" parent="1" style="text;html=1;fontSize=7;fontStyle=1;align=center;verticalAlign=middle;fillColor=#F97316;fontColor=#FFFFFF;rounded=1;strokeColor=none;" value="queue.2&#xa;points 20-29" vertex="1">
          <mxGeometry height="25" width="70" x="1130" y="740" as="geometry" />
        </mxCell>
        <mxCell id="ring-explain" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=#1E293B;fontColor=#A5F3FC;rounded=1;strokeColor=#334155;spacingLeft=10;spacingTop=8;" value="How the Hash Ring Works:&#xa;&#xa;1. Each queue gets N points on the ring&#xa;   (N = weight from QueueBind routing key)&#xa;   Weight &quot;10&quot; = 10 points per queue&#xa;   3 queues × 10 = 30 total ring points&#xa;&#xa;2. On publish, RabbitMQ:&#xa;   a) Takes routing key: &quot;1-CAR-05&quot;&#xa;   b) Computes: hash(&quot;1-CAR-05&quot;) = 738291&#xa;   c) Finds position: 738291 mod 30 = 21&#xa;   d) Point 21 → belongs to queue.2&#xa;   e) Message delivered to queue.2&#xa;&#xa;3. Same routing key = same hash = same queue&#xa;   ALWAYS. Deterministic." vertex="1">
          <mxGeometry height="210" width="280" x="820" y="310" as="geometry" />
        </mxCell>
