        <mxCell id="guarantee" parent="1" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=#E8F5E9;fontColor=#1B5E20;rounded=1;strokeColor=#28A745;spacingLeft=8;spacingTop=5;" value="🔑 GUARANTEE:&#xa;Same spot_id → always same queue → serial processing&#xa;Different spot_id → can go to different queues → parallel" vertex="1">
