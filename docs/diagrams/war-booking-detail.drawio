        <mxCell id="sec2b-title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;fontColor=#333333;" value="2b. How x-consistent-hash Works Internally (Hash Ring)" vertex="1">
