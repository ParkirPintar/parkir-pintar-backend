        <mxCell id="nack" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;fontColor=#DC2626;fontSize=8;fontStyle=1;strokeColor=#DC2626;" value="NACK&#xa;(spot taken)" vertex="1">
          <mxGeometry height="35" width="110" x="400" y="810" as="geometry" />
        </mxCell>
        <mxCell id="enack" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;fontSize=7;fontColor=#DC2626;fontStyle=2;dashed=1;" target="nack" value="lock failed">
          <mxGeometry relative="1" as="geometry" />
