        <mxCell id="sec4-title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;fontColor=#333333;" value="4. Why Zero Double-Booking?" vertex="1">
          <mxGeometry height="30" width="400" x="40" y="870" as="geometry" />
        </mxCell>
        <mxCell id="why1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F97316;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#cc6600;" value="① Consistent Hash&#xa;Same spot_id → same queue&#xa;(no two workers process&#xa;same spot simultaneously)" vertex="1">
          <mxGeometry height="70" width="180" x="40" y="910" as="geometry" />
        </mxCell>
        <mxCell id="why2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#047857;" value="② Serial Consumer&#xa;1 message at a time per queue&#xa;(auto-ack=false, manual ACK&#xa;after DB write succeeds)" vertex="1">
          <mxGeometry height="70" width="180" x="240" y="910" as="geometry" />
        </mxCell>
        <mxCell id="why3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#991b1b;" value="③ Redis SETNX&#xa;Atomic lock — only 1 can&#xa;acquire per spot_id&#xa;(TTL 1h auto-release)" vertex="1">
          <mxGeometry height="70" width="180" x="440" y="910" as="geometry" />
        </mxCell>
        <mxCell id="why4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8B5CF6;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#6d28d9;" value="④ Idempotency Key&#xa;Duplicate requests return&#xa;same result (no re-processing)&#xa;Stored in Redis TTL 24h" vertex="1">
          <mxGeometry height="70" width="180" x="640" y="910" as="geometry" />
        </mxCell>
        <mxCell id="result" parent="1" style="text;html=1;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fillColor=#052E16;fontColor=#86EFAC;rounded=1;strokeColor=#16A34A;" value="RESULT: 120 VUs × 6237 iterations × 0 double-bookings (proven via k6 load test)" vertex="1">
          <mxGeometry height="30" width="780" x="40" y="990" as="geometry" />
        </mxCell>
        <mxCell id="code-title" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;fontColor=#333333;" value="Code References" vertex="1">
          <mxGeometry height="25" width="200" x="850" y="80" as="geometry" />
        </mxCell>
        <mxCell id="code1" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=#1E293B;fontColor=#A5F3FC;rounded=1;strokeColor=#334155;fontFamily=monospace;spacingLeft=8;spacingTop=5;" value="adapter/publisher.go&#xa;&#xa;ExchangeDeclare(&#xa;  &quot;booking.exchange&quot;,&#xa;  &quot;x-consistent-hash&quot;,&#xa;  durable: true&#xa;)&#xa;&#xa;PublishWithContext(&#xa;  exchange: bookingExchange,&#xa;  routingKey: spotID,  // ← hash key&#xa;  body: payload&#xa;)" vertex="1">
          <mxGeometry height="180" width="230" x="850" y="110" as="geometry" />
        </mxCell>
        <mxCell id="code2" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=#1E293B;fontColor=#A5F3FC;rounded=1;strokeColor=#334155;fontFamily=monospace;spacingLeft=8;spacingTop=5;" value="usecase/queue_worker.go&#xa;&#xa;QueueDeclare(queueName, durable)&#xa;QueueBind(queueName, &quot;10&quot;,&#xa;  &quot;booking.exchange&quot;)&#xa;&#xa;msgs := ch.Consume(&#xa;  queue, autoAck: false&#xa;)&#xa;&#xa;for msg := range msgs {&#xa;  processMessage(ctx, msg)&#xa;  // serial: next msg waits&#xa;  // until ACK/NACK&#xa;}" vertex="1">
          <mxGeometry height="200" width="230" x="1110" y="80" as="geometry" />
        </mxCell>
        <mxCell id="code3" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=#1E293B;fontColor=#A5F3FC;rounded=1;strokeColor=#334155;fontFamily=monospace;spacingLeft=8;spacingTop=5;" value="cmd/main.go&#xa;&#xa;// All in same process:&#xa;go grpcServer.Serve(lis)&#xa;go httpRouter.Run(&quot;:8080&quot;)&#xa;go queueWorker.Start(ctx)&#xa;go expiryWorker.Start(ctx)&#xa;&#xa;// Scale via K8s HPA:&#xa;// minReplicas: 3&#xa;// maxReplicas: 20&#xa;// metric: CPU 60%" vertex="1">
          <mxGeometry height="170" width="230" x="1110" y="310" as="geometry" />
        </mxCell>
        <mxCell id="bind-note" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=#FFF3E0;fontColor=#333333;rounded=1;strokeColor=#FF8C00;spacingLeft=8;spacingTop=5;" value="QueueBind weight &quot;10&quot;:&#xa;Consistent hash uses weight to&#xa;determine how many hash ring&#xa;points this queue occupies.&#xa;&quot;10&quot; = equal distribution across&#xa;all bound queues." vertex="1">
          <mxGeometry height="90" width="230" x="1410" y="890" as="geometry" />
        </mxCell>
      </root>
