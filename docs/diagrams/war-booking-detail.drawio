        <mxCell id="td4e" parent="tr4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;overflow=hidden;fontSize=7;fontStyle=1;fontColor=#28A745;top=0;left=0;bottom=0;right=0;" value="✅ SAME as row 1!&#xa;(deterministic)" vertex="1">
          <mxGeometry height="30" width="120" x="370" as="geometry">
