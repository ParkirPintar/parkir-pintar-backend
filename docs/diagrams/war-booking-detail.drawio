        <mxCell id="weight-box" parent="1" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=#FFF3E0;fontColor=#333333;rounded=1;strokeColor=#FF8C00;spacingLeft=10;spacingTop=8;fontFamily=monospace;" value="QueueBind Weight Explained:&#xa;&#xa;QueueBind(&quot;booking.queue.0&quot;, &quot;10&quot;, &quot;booking.exchange&quot;)&#xa;                                    ↑&#xa;                          routing_key = WEIGHT (not pattern!)&#xa;&#xa;• Weight &quot;10&quot; = queue gets 10 points on hash ring&#xa;• 3 queues × weight 10 = 30 total ring points&#xa;• Equal weight = equal distribution (~33% each)&#xa;• Weight &quot;20&quot; = 2× more messages than weight &quot;10&quot;&#xa;&#xa;Why &quot;Consistent&quot;?&#xa;• Add queue.3 → only ~25% messages redistribute&#xa;• Remove queue.1 → only its messages move&#xa;• NOT like simple mod N (which reshuffles everything)" vertex="1">
          <mxGeometry height="185" width="490" x="900" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="sec3-title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;fontColor=#333333;" value="3. Queue Worker — Serial Processing per Message" vertex="1">
          <mxGeometry height="30" width="600" x="40" y="650" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#1d4ed8;" value="① Dequeue&#xa;&#xa;msg := &lt;-msgs&#xa;(blocks until&#xa;message available)" vertex="1">
          <mxGeometry height="80" width="130" x="40" y="700" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8B5CF6;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#6d28d9;" value="② Idempotency Check&#xa;&#xa;Redis GET&#xa;idempotency:{key}&#xa;→ duplicate? ACK &amp; skip" vertex="1">
          <mxGeometry height="80" width="150" x="200" y="700" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#991b1b;" value="③ Redis SETNX&#xa;&#xa;lock:{spot_id} TTL 1h&#xa;→ OK: continue&#xa;→ FAIL: NACK (reject)" vertex="1">
          <mxGeometry height="80" width="150" x="380" y="700" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#336791;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#1d4e6e;" value="④ INSERT Reservation&#xa;&#xa;status = RESERVED&#xa;booking_fee = 5000&#xa;expires_at = now+1h" vertex="1">
          <mxGeometry height="80" width="150" x="560" y="700" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#28A745;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#1e7e34;" value="⑤ gRPC Billing&#xa;&#xa;ChargeBookingFee()&#xa;→ returns QR code&#xa;for QRIS payment" vertex="1">
          <mxGeometry height="80" width="150" x="740" y="700" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#047857;" value="⑥ ACK Message&#xa;&#xa;msg.Ack(false)&#xa;→ removed from queue&#xa;→ next msg processed" vertex="1">
          <mxGeometry height="80" width="150" x="920" y="700" as="geometry" />
        </mxCell>
