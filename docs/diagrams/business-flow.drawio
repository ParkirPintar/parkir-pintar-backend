  <diagram id="biz-flow-reservation" name="1. Reservation Flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Business Flow: Reservation" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="10" width="300" height="30" as="geometry" />
        </mxCell>
        <!-- Start -->
        <mxCell id="start" value="Driver opens app" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="50" width="140" height="40" as="geometry" />
        </mxCell>
        <!-- View availability -->
        <mxCell id="view-avail" value="View availability&#xa;per floor &amp; vehicle type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="180" height="50" as="geometry" />
        </mxCell>
        <!-- Select mode -->
        <mxCell id="select-mode" value="Select mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="200" width="120" height="80" as="geometry" />
        </mxCell>
        <!-- System assigned -->
        <mxCell id="sys-assign" value="System picks&#xa;first available spot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="140" height="50" as="geometry" />
        </mxCell>
        <!-- User selected -->
        <mxCell id="user-select" value="Driver picks spot&#xa;FIFO hold queue (60s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="220" width="150" height="50" as="geometry" />
        </mxCell>
        <!-- Validate -->
        <mxCell id="validate" value="Validate capacity&#xa;&amp; availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="320" width="160" height="50" as="geometry" />
        </mxCell>
        <!-- Not available -->
        <mxCell id="not-avail" value="Show unavailable" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="130" height="40" as="geometry" />
        </mxCell>
        <!-- Lock inventory -->
        <mxCell id="lock" value="Lock inventory&#xa;Redis SETNX + TTL 1h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="160" height="50" as="geometry" />
        </mxCell>
        <!-- Confirm -->
        <mxCell id="confirm" value="Confirm reservation&#xa;Charge booking fee 5.000 IDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="480" width="190" height="50" as="geometry" />
        </mxCell>
        <!-- Pay booking fee -->
        <mxCell id="pay-booking" value="Driver pays booking fee&#xa;via QRIS (5.000 IDR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="180" height="50" as="geometry" />
        </mxCell>
        <!-- Payment result -->
        <mxCell id="pay-result" value="Payment?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="640" width="100" height="70" as="geometry" />
        </mxCell>
        <!-- Success -->
        <mxCell id="success" value="Reservation confirmed&#xa;Spot held max 1 hour&#xa;Driver gets parking lot ID" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="540" y="740" width="220" height="60" as="geometry" />
        </mxCell>
        <!-- Failed -->
        <mxCell id="failed" value="Reservation cancelled&#xa;Spot released" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="790" y="650" width="150" height="50" as="geometry" />
        </mxCell>
        <!-- Edges -->
        <mxCell id="e1" edge="1" source="start" target="view-avail" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" source="view-avail" target="select-mode" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="System-assigned" style="fontSize=8;" edge="1" source="select-mode" target="sys-assign" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="User-selected" style="fontSize=8;" edge="1" source="select-mode" target="user-select" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" source="sys-assign" target="validate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" source="user-select" target="validate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Not available" style="fontSize=8;" edge="1" source="validate" target="not-avail" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Available" style="fontSize=8;" edge="1" source="validate" target="lock" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" source="lock" target="confirm" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" source="confirm" target="pay-booking" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" edge="1" source="pay-booking" target="pay-result" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="Success" style="fontSize=8;" edge="1" source="pay-result" target="success" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="Failed" style="fontSize=8;" edge="1" source="pay-result" target="failed" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="biz-flow-checkin" name="2. Check-in Flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="Business Flow: Check-in" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="10" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="arrive" value="Driver arrives&#xa;at parking gate" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="checkin-api" value="Check-in via&#xa;Presence Service API&#xa;POST /v1/checkin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="140" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="validate-spot" value="Validate spot&#xa;assignment" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="230" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wrong-spot" value="BLOCKED&#xa;Driver cannot park&#xa;at wrong spot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="call-reservation" value="Presence calls&#xa;Reservation.CheckIn&#xa;status = ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="340" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="call-billing" value="Presence calls&#xa;Billing.StartBillingSession&#xa;Billing starts counting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="430" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="timer-start" value="Driver has 1 hour&#xa;to reach assigned spot" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="520" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ea" edge="1" source="arrive" target="checkin-api" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" edge="1" source="checkin-api" target="validate-spot" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" value="Wrong spot" style="fontSize=8;" edge="1" source="validate-spot" target="wrong-spot" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" value="Correct spot" style="fontSize=8;" edge="1" source="validate-spot" target="call-reservation" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee" edge="1" source="call-reservation" target="call-billing" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef" edge="1" source="call-billing" target="timer-start" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="biz-flow-checkout" name="3. Billing &amp; Checkout Flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title3" value="Business Flow: Billing &amp; Checkout (Pay Before Exit)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="Check-in" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="50" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="Billing timer starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="120" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="midnight" value="Session crosses&#xa;midnight?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="190" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="overnight" value="Add overnight fee&#xa;20.000 IDR flat&#xa;per crossing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hourly" value="Standard hourly rate&#xa;ceil(hours) × 5.000 IDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="300" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="trigger-co" value="Driver triggers checkout&#xa;Must pay before exit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="555" y="380" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="calc" value="Calculate total:&#xa;booking_fee + hourly + overnight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="460" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="invoice" value="Generate invoice&#xa;(idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="540" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="qris" value="Payment via QRIS&#xa;(Pondo Ngopi engine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="610" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pay-check" value="Payment?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="690" width="100" height="70" as="geometry" />
        </mxCell>
        <mxCell id="completed" value="Status: COMPLETED&#xa;Driver can exit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="790" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="retry" value="Retry / show error&#xa;Driver cannot exit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="700" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f1" edge="1" source="ci" target="timer" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" edge="1" source="timer" target="midnight" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="Yes" style="fontSize=8;" edge="1" source="midnight" target="overnight" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="No" style="fontSize=8;" edge="1" source="midnight" target="hourly" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" edge="1" source="overnight" target="hourly" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" edge="1" source="hourly" target="trigger-co" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" edge="1" source="trigger-co" target="calc" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" edge="1" source="calc" target="invoice" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" edge="1" source="invoice" target="qris" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" edge="1" source="qris" target="pay-check" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" value="Success" style="fontSize=8;" edge="1" source="pay-check" target="completed" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="Failure" style="fontSize=8;" edge="1" source="pay-check" target="retry" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="biz-flow-cancel" name="4. Cancellation &amp; No-show">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title4" value="Business Flow: Cancellation &amp; No-show" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="10" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cancel-start" value="Driver cancels" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="60" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="when" value="When?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="130" width="90" height="70" as="geometry" />
        </mxCell>
        <mxCell id="free" value="Fee: 0 IDR&#xa;(≤ 2 min after confirm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fee5k" value="Fee: 5.000 IDR&#xa;(&gt; 2 min, before check-in)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="240" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="noshow" value="Fee: 10.000 IDR&#xa;(No-show &gt; 1 hour)&#xa;Reservation auto-expired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="release" value="Release spot&#xa;to inventory" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="340" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g1" edge="1" source="cancel-start" target="when" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" value="≤ 2 min" style="fontSize=8;" edge="1" source="when" target="free" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" value="> 2 min" style="fontSize=8;" edge="1" source="when" target="fee5k" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" value="No-show" style="fontSize=8;" edge="1" source="when" target="noshow" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g5" edge="1" source="free" target="release" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g6" edge="1" source="fee5k" target="release" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g7" edge="1" source="noshow" target="release" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
